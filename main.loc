\contentsline {added}{Added: \truncate {\Changestruncatewidth }{Plataforma web con geolocalización y verificación para la búsqueda de viviendas en arrendamiento: caso de estudiantes de la Universidad de la Sierra Sur}}{\es@scroman {}}{section*.1}%
