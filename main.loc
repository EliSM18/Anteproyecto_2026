\contentsline {added}{Added: \truncate {\Changestruncatewidth }{; el que más se acerca \blx@tocontentsinit {0}\parencite {Bisquera2026} compara tiempos estimados por los usuarios y no incluye la confianza ni un mecanismo de verificación de arrendadores}}{8}{section*.37}%
\contentsline {added}{Added: \truncate {\Changestruncatewidth }{que incorpore mecanismos de verificación de arrendadores e inmuebles,}}{8}{section*.38}%
