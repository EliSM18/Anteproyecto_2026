% ---------- Datos de identificación ----------
\makeatletter
\newcommand{\TituloProyecto}[1]{\gdef\mc@titulo{#1}}
\newcommand{\Tesistas}[1]{\gdef\mc@tesistas{#1}}
\newcommand{\Asesores}[1]{\gdef\mc@asesores{#1}}
\newcommand{\AsesorValida}[1]{\gdef\mc@asesorvalida{#1}}
\newcommand{\Profesor}[1]{\gdef\mc@profesor{#1}}
\newcommand{\VersionRevisada}[1]{\gdef\mc@vrevisada{#1}}
\newcommand{\VersionEntregada}[1]{\gdef\mc@ventregada{#1}}
\newcommand{\TotalObservaciones}[1]{\gdef\mc@totalobs{#1}}
\TituloProyecto{}\Tesistas{}\Asesores{}\AsesorValida{}\Profesor{}
\VersionRevisada{}\VersionEntregada{}\TotalObservaciones{}

% ---------- Encabezado del documento ----------
\newcommand{\EncabezadoMatriz}{%
  \begin{center}
    {\LARGE\bfseries\color{titulo}Matriz de control de cambios del anteproyecto de tesis\par}
    \vspace{3pt}
    {\small\color{gris}Respuesta a las observaciones del profesor de Metodología de la
